generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  COD
  MOCK_ONLINE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum OrderSyncStatus {
  NOT_REQUIRED
  PENDING
  SYNCED
}

model Payment {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @db.Uuid
  customerId            String          @db.Uuid
  amount                Decimal         @db.Decimal(18, 2)
  method                PaymentMethod
  status                PaymentStatus
  providerTransactionId String?         @unique
  failureCode           String?
  idempotencyKey        String          @db.VarChar(255)
  requestHash           String          @db.Char(64)
  orderSyncStatus       OrderSyncStatus @default(NOT_REQUIRED)
  orderSyncAttempts     Int             @default(0)
  nextOrderSyncAt       DateTime?
  orderSyncedAt         DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([customerId, idempotencyKey])
  @@index([orderId])
  @@index([customerId, createdAt])
  @@index([orderSyncStatus, nextOrderSyncAt])
  @@map("payments")
}
