PORT=3004
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiuber_payment?schema=public
AUTH_SERVICE_URL=http://localhost:3000
ORDER_SERVICE_URL=http://localhost:3003
RPC_TIMEOUT_MS=5000
INTERNAL_SERVICE_KEY=replace-with-the-same-long-random-secret-as-order
PAYMENT_PROVIDER=MOCK
ENABLE_MOCK_PAYMENT_PROVIDER=true
MOCK_ONLINE_OUTCOME=PENDING
MOCK_PROVIDER_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
ORDER_SYNC_INTERVAL_MS=5000
ORDER_SYNC_RETRY_BASE_MS=1000
FRONTEND_ORIGIN=http://localhost:5173
