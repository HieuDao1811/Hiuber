generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  MOCK_ONLINE
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Order {
  id             String         @id @default(uuid()) @db.Uuid
  customerUserId String         @db.Uuid
  restaurantId   String         @db.Uuid
  status         OrderStatus    @default(PENDING)
  paymentMethod  PaymentMethod?
  paymentStatus  PaymentStatus  @default(UNPAID)

  addressLabel    String?
  deliveryAddress String
  receiverName    String
  receiverPhone   String

  subtotal    Decimal @db.Decimal(18, 2)
  deliveryFee Decimal @db.Decimal(18, 2)
  totalPrice  Decimal @db.Decimal(18, 2)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]

  @@index([customerUserId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id         String @id @default(uuid()) @db.Uuid
  orderId    String @db.Uuid
  menuItemId String @db.Uuid

  name      String
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(18, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, menuItemId])
  @@index([orderId])
  @@map("order_items")
}
